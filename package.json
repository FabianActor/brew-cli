{
  "name": "@fabianactor/brew-cli",
  "version": "0.3.6",
  "type": "module",
  "description": "CLI for operating brew-guide data in Supabase: beans, brewing notes, equipment and methods.",
  "author": {
    "name": "FabianActor",
    "url": "https://github.com/FabianActor"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/FabianActor/brew-cli"
  },
  "keywords": [
    "cli",
    "brew-guide",
    "supabase",
    "coffee"
  ],
  "files": [
    "dist/",
    "skills/",
    "CHANGELOG.md",
    "NOTICE"
  ],
  "bin": {
    "brew-guide": "./dist/main.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.50.0",
    "c12": "^2.0.0",
    "citty": "^0.1.6"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.8.0"
  },
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch --onSuccess \"node scripts/chmod-bin.mjs\"",
    "postbuild": "node scripts/chmod-bin.mjs",
    "dev": "tsx src/main.ts",
    "test": "npm run typecheck && node --import tsx --test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm test && npm run build"
  }
}
